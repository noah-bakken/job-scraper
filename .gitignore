# Virtualenv
venv/
.venv/
__pycache__/
*.pyc

# Credentials — never commit service-account keys or any JSON secrets
*.json
!.github/**/*.json
# The scraper's source list: public board identifiers only (company names and
# ATS slugs / Workday tenants), no credentials. Without this exception the blanket
# *.json rule above silently drops it from commits.
!sources_extra.json

# Local env
.env

# Sheet backups and cleanup working files. Not secret, but this repo is public
# and these hold your personal job list.
sheet_backup*.csv
sheet_backup*.json
cleanup_decisions.json
rm_rows.json
